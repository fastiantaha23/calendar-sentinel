# Copy to .env for local runs. NEVER commit .env. On Render set these in the dashboard (Environment).
HOST=127.0.0.1
PORT=8000

# Provider: gemini | anthropic
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-2.5-flash-lite
# Models the UI selector may offer (provider:model, comma separated). Only entries whose provider key is set are exposed.
ALLOWED_MODELS=gemini:gemini-2.5-flash-lite,gemini:gemini-2.5-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# '0' disables hidden "thinking" tokens on Gemini flash models; leave empty to omit the setting.
GEMINI_THINKING_BUDGET=0
# Optional cost table, USD per 1M tokens [input, output]. Check the provider's current pricing page.
MODEL_PRICES_JSON={}

# Execution limits
MAX_STEPS=6
MAX_TOOL_RETRIES=2
MAX_REPAIRS=2
MAX_OUTPUT_TOKENS=512
MAX_TOTAL_TOKENS=30000
MAX_INPUT_CHARS=24000
RUN_TIMEOUT_SECONDS=40
MODEL_TIMEOUT_SECONDS=14
TOOL_TIMEOUT_SECONDS=3

# Public-service protection
CHAT_RATE_PER_MINUTE=20
MAX_CONCURRENT_RUNS=4
DAILY_MODEL_CALL_CAP=5000

APP_TIMEZONE=UTC
# FIXED_TODAY=2026-10-05   # only for reproducible local tests
